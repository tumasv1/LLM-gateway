# Скопируй в .env и заполни. .env в git НЕ попадает.

# ── Master key шлюза (админ + дефолтный доступ). Длинный случайный секрет, начинается с sk- ──
# сгенерировать: openssl rand -hex 24  →  префикс sk-
LITELLM_MASTER_KEY=sk-CHANGE-ME-long-random

# ── Postgres (данные платформы: virtual keys, бюджеты, история расходов) ──
POSTGRES_PASSWORD=change-me-db
# DATABASE_URL должен содержать тот же пароль, что и POSTGRES_PASSWORD; хост = имя сервиса postgres
DATABASE_URL=postgresql://litellm:change-me-db@postgres:5432/litellm

# ── Redis (счётчики rpm/tpm для балансировки + кэш) ──
REDIS_PASSWORD=change-me-redis

# ── Ключи провайдеров (живут ТОЛЬКО здесь, в одном месте; клиентам не раздаются) ──
OPENROUTER_API_KEY=sk-or-v1-...
NANOGPT_API_KEY=sk-nano-...
DEEPSEEK_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Langfuse (проект llm-gateway; RAGv2 граф пишет в свой проект своими ключами) ──
# Ключи — UI Langfuse → проект llm-gateway → Settings → API Keys.
LANGFUSE_HOST=http://<langfuse-lxc-ip>:3000
# OTEL ingest: {LANGFUSE_HOST}/api/public/otel (preset langfuse_otel). Если не задан — берётся LANGFUSE_HOST.
LANGFUSE_OTEL_HOST=http://<langfuse-lxc-ip>:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# окружение трейсов (фильтр в UI Langfuse): на LXC — production
LANGFUSE_TRACING_ENVIRONMENT=production

# ── Presidio (маскирование ПДн до внешней модели). URL внутри docker-сети. ──
# Сам guardrail и привязка к ключу — в UI LiteLLM, не в YAML.
PRESIDIO_ANALYZER_API_BASE=http://presidio-analyzer:3000
PRESIDIO_ANONYMIZER_API_BASE=http://presidio-anonymizer:3000
